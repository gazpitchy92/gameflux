#!/bin/bash

# Flag files
scx_file="/etc/gameflux/flags/scx.txt"
pid_file="/etc/gameflux/flags/pid.txt"
[ -f "$scx_file" ] || echo "none" > "$scx_file"
: > "$pid_file"

# Clear ram buffer
echo 3 | sudo tee /proc/sys/vm/drop_caches

# Parse given flags
args=()
scx_set="none"
fsr4_set=false
rdna3_set=false
fsync_set=false
wayland_set=false
for arg in "$@"; do
    case "$arg" in
        --wayland=true)
            wayland_set=true
            ;;
        --fsr4=true)
            fsr4_set=true
            ;;
        --rdna3=true)
            rdna3_set=true
            ;;
        --fsync=true)
            fsync_set=true
            ;;
        --scx=none|--scx=lavd|--scx=bpfland|--scx=cosmos|--scx=rusty|--scx=p2dq|--scx=flash)
            scx_set="${arg#--scx=}"
            ;;
        *)
            args+=("$arg")
            ;;
    esac
done

# Get game dir
for arg in "${args[@]}"; do
    if [[ "$arg" == /mnt/games/SteamLibrary/steamapps/common/* ]] && [[ "$arg" != *SteamLinuxRuntime_sniper* ]]; then
        game_exe=$arg
        game_root=$(dirname "$game_exe")
        win64_path=$(find "$game_root" -type d -name "Win64" ! -path "$game_root/Engine/*" | head -n 1)
        game_folder="$win64_path"
        echo "Game exe: $arg" > /etc/gameflux/logs/game.txt
        echo "Game dir: $game_folder" >> /etc/gameflux/logs/game.txt
        break
    fi
done

# Install optiscalar 
if [ "$fsr4_set" = true ]; then
    if [ ! -f "$game_folder/dxgi.dll" ]; then
        cp -r /etc/gameflux/OptiScaler/* "$game_folder/"
        if [ -f "$game_folder/dxgi.dll" ]; then
            echo "OptiScaler copied successfully" >> /etc/gameflux/logs/game.txt
        else
            echo "OptiScaler copy failed" >> /etc/gameflux/logs/game.txt
        fi
    else
        echo "OptiScaler already installed" >> /etc/gameflux/logs/game.txt
    fi
elif [ -f "$game_folder/dxgi.dll" ]; then
    for item in /etc/gameflux/OptiScaler/*; do
        name=$(basename "$item")
        echo "OptiScaler cleanup removing: $game_folder/$name" >> /etc/gameflux/logs/game.txt
        rm -rf "$game_folder/$name"
    done
fi

# Log settings
echo "$scx_set" > "$scx_file"
echo "fsr4: $fsr4_set" >> /etc/gameflux/logs/game.txt
echo "rdna3: $rdna3_set" >> /etc/gameflux/logs/game.txt
echo "fsync: $fsync_set" >> /etc/gameflux/logs/game.txt
echo "scx: $scx_set" >> /etc/gameflux/logs/game.txt
echo "wayland: $wayland_set" >> /etc/gameflux/logs/game.txt
echo "other args: ${args[*]}" >> /etc/gameflux/logs/game.txt

# Setup ini
if [ "$rdna3_set" = "true" ]; then
    # TO DO : Update .ini file with flags to enable rdna3
else
    # TO DO : Update .ini file with flags to disable rdna3
fi
 
# Build run variables
envs=()
if [ "$wayland_set" = "true" ]; then
    envs+=("LD_PRELOAD='' PROTON_ENABLE_WAYLAND=1")
fi
if [ "$fsync_set" = "true" ]; then
    envs+=("PROTON_USE_NTSYNC=0")
else
    envs+=("PROTON_USE_NTSYNC=1" "WINE_DISABLE_FAST_SYNC=0")
fi
if [ "$fsr4_set" = "true" ]; then
    envs+=("PROTON_FSR_UPGRADE=1")
fi
if [ "$rdna3_set" = "true" ]; then
    envs+=("DXIL_SPIRV_CONFIG=wmma_rdna3_workaround" "WINEDLLOVERRIDES=dxgi.dll=n,b")
    # TO DO : Update .ini file with flags to enable rdna3
else
    # TO DO : Update .ini file with flags to disable rdna3
fi

# Launch the game
env "${envs[@]}" gamemoderun "${args[@]}" &

# Log game PID numbers whilst running
GAMEMODE_PID=$!
echo "$GAMEMODE_PID" > "$pid_file"
sleep 15
while kill -0 "$GAMEMODE_PID" 2>/dev/null; do
    GAME_PIDS=$(pgrep -P "$GAMEMODE_PID")
    # Parse game PID numbers
    for PID in $GAME_PIDS; do
        if kill -0 "$PID" 2>/dev/null; then
            # Log the running PID number
            current_nice=$(ps -o nice= -p "$PID" | tr -d ' ')
            if [[ -n "$current_nice" && "$current_nice" != "-" && "$current_nice" =~ [0-9] ]]; then
                grep -Fxq "$PID" "$pid_file" || echo "$PID" >> "$pid_file"
                sleep 0.5
            fi
        fi
    done
    # Sleep time... Zzzzzz
    sleep 60
done